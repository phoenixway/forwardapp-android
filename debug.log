41\\u044f...",\n    "after_execution": "\\u0420\\u0435\\u0437\\u0443\\u043b\\u044c\\u0442\\u0430\\u0442\\u0438 \\u043e\\u0442\\u0440\\u0438\\u043c\\u0430\\u043d\\u043e"\n}\n</action>''
