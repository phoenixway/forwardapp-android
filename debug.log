2026-02-14 11:43:13,028 - debug - DEBUG - Action.start type=edit_file command={'path': 'app/src/main/java/com/romankozak/forwardappmobile/features/mainscreen/DashboardContent.kt', 'search_text': '@Composable\nprivate fun QuickActionCard(action: QuickAction) {\n    Card(\n        onClick = action.onClick,\n        shape = RoundedCornerShape(16.dp),\n        colors = CardDefaults.cardColors(containerColor = Color.White.copy(alpha = 0.05f)),\n        modifier = Modifier.fillMaxWidth(),\n    ) {\n        Row(\n            modifier = Modifier.padding(horizontal = 14.dp, vertical = 12.dp),\n            verticalAlignment = Alignment.CenterVertically,\n        ) {\n            Box(\n                modifier = Modifier.size(38.dp).background(action.tint.copy(alpha = 0.24f), CircleShape),\n                contentAlignment = Alignment.Center,\n            ) {\n                Icon(\n                    imageVector = action.icon,\n                    contentDescription = null,\n                    tint = action.tint,\n                )\n            }\n            Spacer(modifier = Modifier.width(12.dp))\n            Column(modifier = Modifier.weight(1f)) {\n                Text(action.title, color = MaterialTheme.colorScheme.onSurface, fontWeight = FontWeight.Medium)\n                Text(action.subtitle, color = MaterialTheme.colorScheme.onSurfaceVariant, style = MaterialTheme.typography.bodySmall)\n            }\n        }\n    }\n}', 'replace_text': '@Composable\nprivate fun QuickActionCard(action: QuickAction) {\n    Card(\n        onClick = action.onClick,\n        shape = RoundedCornerShape(16.dp),\n        colors = CardDefaults.cardColors(containerColor = Color.White.copy(alpha = 0.05f)),\n        modifier = Modifier.fillMaxWidth(),\n    ) {\n        Row(\n            modifier = Modifier.padding(horizontal = 14.dp, vertical = 12.dp),\n            verticalAlignment = Alignment.CenterVertically,\n        ) {\n            Box(\n                modifier = Modifier.size(38.dp).background(action.tint.copy(alpha = 0.24f), CircleShape),\n                contentAlignment = Alignment.Center,\n            ) {\n                Icon(\n                    imageVector = action.icon,\n                    contentDescription = null,\n                    tint = action.tint,\n                )\n            }\n            Spacer(modifier = Modifier.width(12.dp))\n            Column(modifier = Modifier.weight(1f)) {\n                Text(action.title, color = MaterialTheme.colorScheme.onSurface, fontWeight = FontWeight.Medium)\n                Text(action.subtitle, color = MaterialTheme.colorScheme.onSurfaceVariant, style = MaterialTheme.typography.bodySmall)\n            }\n        }\n    }\n}\n\n@Composable\nprivate fun AiInsightCard(insight: com.romankozak.forwardappmobile.features.ai.insights.AiMessage) {\n    val backgroundColor = when (insight.type) {\n        com.romankozak.forwardappmobile.features.ai.insights.MessageType.MOTIVATION -> MaterialTheme.colorScheme.primaryContainer\n        com.romankozak.forwardappmobile.features.ai.insights.MessageType.JOKE -> MaterialTheme.colorScheme.secondaryContainer\n        com.romankozak.forwardappmobile.features.ai.insights.MessageType.INFO -> MaterialTheme.colorScheme.tertiaryContainer\n        com.romankozak.forwardappmobile.features.ai.insights.MessageType.WARNING -> MaterialTheme.colorScheme.errorContainer\n        com.romankozak.forwardappmobile.features.ai.insights.MessageType.ERROR -> MaterialTheme.colorScheme.errorContainer\n    }\n    val textColor = when (insight.type) {\n        com.romankozak.forwardappmobile.features.ai.insights.MessageType.MOTIVATION -> MaterialTheme.colorScheme.onPrimaryContainer\n        com.romankozak.forwardappmobile.features.ai.insights.MessageType.JOKE -> MaterialTheme.colorScheme.onSecondaryContainer\n        com.romankozak.forwardappmobile.features.ai.insights.MessageType.INFO -> MaterialTheme.colorScheme.onTertiaryContainer\n        com.romankozak.forwardappmobile.features.ai.insights.MessageType.WARNING -> MaterialTheme.colorScheme.onErrorContainer\n        com.romankozak.forwardappmobile.features.ai.insights.MessageType.ERROR -> MaterialTheme.colorScheme.onErrorContainer\n    }\n    \n    Card(\n        modifier = Modifier.fillMaxWidth(),\n        shape = RoundedCornerShape(16.dp),\n        colors = CardDefaults.cardColors(containerColor = backgroundColor),\n    ) {\n        Column(\n            modifier = Modifier.padding(14.dp),\n            verticalArrangement = Arrangement.spacedBy(4.dp),\n        ) {\n            Text(\n                text = insight.text,\n                color = textColor,\n                style = MaterialTheme.typography.bodyMedium,\n                fontWeight = if (insight.isRead) FontWeight.Normal else FontWeight.Bold,\n            )\n            Text(\n                text = "${insight.type.name.lowercase().replaceFirstChar { it.uppercase() }} • ${java.text.SimpleDateFormat("HH:mm", java.util.Locale.getDefault()).format(java.util.Date(insight.timestamp))}",\n                color = textColor.copy(alpha = 0.7f),\n                style = MaterialTheme.typography.labelSmall,\n            )\n        }\n    }\n}', 'before_execution': 'Додаю функцію AiInsightCard для відображення картки інсайту', 'during_execution': 'Редагую файл...', 'after_execution': 'Функцію AiInsightCard додано', 'type': 'edit_file'}
