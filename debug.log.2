<action>
{
  "type": "read_chunk",
  "path": "app/src/main/java/com/example/feature/Screen.kt",
  "start_line": 140,
  "end_line": 152,
  "before_execution": "Reading the exact target block before edit_file",
  "during_execution": "Reading lines 140-152...",
